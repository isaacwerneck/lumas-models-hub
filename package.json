{
  "name": "lumasmodels-hub",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace @lumas/api",
    "dev:web": "npm run dev --workspace web",
    "build:api": "npm run build --workspace @lumas/api",
    "build:web": "npm run build --workspace web",
    "build:netlify": "npm run build:web && node scripts/prepare-netlify.mjs",
    "build": "npm run build:api && npm run build:web",
    "lint": "npm run lint --workspace web",
    "coverage": "npm run coverage:api && npm run coverage:web",
    "coverage:api": "npm run test --workspace @lumas/api -- --coverage",
    "coverage:web": "npm run test --workspace web -- --coverage",
    "test:e2e": "npm run test:e2e --workspace web",
    "test": "npm run test:api && npm run test:web",
    "test:api": "npm run test --workspace @lumas/api",
    "test:web": "npm run test --workspace web",
    "prisma:migrate": "npm run prisma:migrate --workspace @lumas/api",
    "prisma:seed": "npm run prisma:seed --workspace @lumas/api"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@vitest/coverage-v8": "4.1.11"
  },
  "dependencies": {
    "uuid": "11.1.1"
  }
}
