PORT=3333
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lumasmodels_hub?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/lumasmodels_hub?schema=public
JWT_ACCESS_SECRET=change-this-access-secret-with-32-chars-minimum
JWT_REFRESH_SECRET=change-this-refresh-secret-with-32-chars-minimum
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=lumas_refresh_token
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
TRUST_PROXY=false
LOGIN_RATE_LIMIT_MAX=5
COMMISSION_DIVISOR=4
OCR_LOW_CONFIDENCE_THRESHOLD=0.8
OCR_LANG=por+eng
TZ=America/Sao_Paulo
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=.data/evidence
# Produção futura (S3/R2 compatível):
# S3_ENDPOINT=https://account-id.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=lumas-evidence
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
STORAGE_DELETE_INTERVAL_MS=60000

# Obrigatórias apenas para executar o seed em produção. A senha não deve ser
# reutilizada e o primeiro login exigirá a troca.
# BOOTSTRAP_MANAGER_USERNAME=
# BOOTSTRAP_MANAGER_DISPLAY_NAME=
# BOOTSTRAP_MANAGER_PASSWORD=
