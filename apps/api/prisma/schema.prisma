generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CHATTER
  MANAGER
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum EarningsStatus {
  PENDING
  PAID
}

enum AuditAction {
  LOGIN
  LOGIN_FAILED
  ACCOUNT_LOCKED
  LOGOUT
  PASSWORD_CHANGED
  USER_CREATED
  USER_UPDATED
  TAG_CREATED
  TAG_UPDATED
  TAG_DELETED
  CHATTER_MODEL_TAGS_UPDATED
  SHIFT_STARTED
  SHIFT_CLOSED
  SHIFT_UPDATED
  SHIFT_NOTES_UPDATED
  PAYMENT_MADE
  SHIFT_DELETED
  EVIDENCE_UPLOADED
  EVIDENCE_PURGED
  PASSWORD_RESET
  SESSIONS_REVOKED
}

enum NotificationType {
  OCR_LOW_CONFIDENCE
  NEGATIVE_SHIFT
}

enum EvidenceStatus {
  AVAILABLE
  PURGE_PENDING
  PURGED
  MISSING_LEGACY
}

enum StorageDeletionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id                  String            @id @default(cuid())
  username            String            @unique
  displayName         String
  passwordHash        String
  role                Role
  isActive            Boolean           @default(true)
  failedLoginAttempts Int               @default(0)
  lockedUntil         DateTime?
  authVersion         Int               @default(0)
  mustChangePassword  Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  chatterModelTags    ChatterModelTag[] @relation("ChatterTags")
  shifts              Shift[]           @relation("ChatterShifts")
  sentMessages        ChatMessage[]     @relation("MessageSender")
  refreshSessions     RefreshSession[]
  earnings            Earnings[]        @relation("ChatterEarnings")
  paymentHistory      PaymentHistory[]  @relation("ChatterPayments")
  paidPayments        PaymentHistory[]  @relation("ManagerPayments")
  auditEntries        AuditLog[]        @relation("AuditActor")
  notifications       Notification[]
  uploadedEvidence    Evidence[]

  @@index([role])
}

model ModelTag {
  id               String            @id @default(cuid())
  name             String            @unique
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  chatterLinks     ChatterModelTag[]
  shifts           Shift[]
  messages         ChatMessage[]
}

model ChatterModelTag {
  id               String   @id @default(cuid())
  chatterId        String
  modelTagId       String
  createdAt        DateTime @default(now())

  chatter          User     @relation("ChatterTags", fields: [chatterId], references: [id], onDelete: Cascade)
  modelTag         ModelTag @relation(fields: [modelTagId], references: [id], onDelete: Cascade)

  @@unique([chatterId, modelTagId])
  @@index([modelTagId])
}

model Shift {
  id                   String      @id @default(cuid())
  chatterId            String
  modelTagId           String
  status               ShiftStatus @default(OPEN)
  startedAt            DateTime
  endedAt              DateTime?

  startImageUrl        String?
  startEvidenceId      String?     @unique
  startOcrRawText      String?
  startOcrConfidence   Decimal?    @db.Decimal(5, 4)
  startValueCents      Int
  startOriginalCurrency String     @default("BRL")
  startOriginalAmountCents Int?
  startFxRate          Decimal?    @db.Decimal(18, 8)
  startFxProvider      String?
  startFxQuotedAt      DateTime?
  startValueConfirmedAt DateTime?

  endImageUrl          String?
  endEvidenceId        String?     @unique
  endOcrRawText        String?
  endOcrConfidence     Decimal?    @db.Decimal(5, 4)
  endValueCents        Int?
  endOriginalCurrency String?
  endOriginalAmountCents Int?
  endFxRate            Decimal?    @db.Decimal(18, 8)
  endFxProvider        String?
  endFxQuotedAt        DateTime?
  endValueConfirmedAt  DateTime?

  grossAmountCents     Int?
  commissionDivisor    Int?
  payoutAmountCents    Int?
  negativeJustification String?
  notes                String?

  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  chatter              User        @relation("ChatterShifts", fields: [chatterId], references: [id], onDelete: Restrict)
  modelTag             ModelTag    @relation(fields: [modelTagId], references: [id], onDelete: Restrict)
  earnings             Earnings?
  startEvidence        Evidence?   @relation("StartEvidence", fields: [startEvidenceId], references: [id], onDelete: SetNull)
  endEvidence          Evidence?   @relation("EndEvidence", fields: [endEvidenceId], references: [id], onDelete: SetNull)

  @@index([chatterId, startedAt])
  @@index([modelTagId, status])
}

model Earnings {
  id          String         @id @default(cuid())
  chatterId   String
  shiftId     String         @unique
  amountCents Int
  status      EarningsStatus @default(PENDING)
  paidAt      DateTime?
  paymentId   String?
  createdAt   DateTime       @default(now())

  chatter     User           @relation("ChatterEarnings", fields: [chatterId], references: [id], onDelete: Restrict)
  shift       Shift          @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  payment     PaymentHistory? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([chatterId, status])
  @@index([status])
  @@index([paymentId])
}

model PaymentHistory {
  id         String   @id @default(cuid())
  chatterId  String
  managerId  String
  totalCents Int
  paidAt     DateTime @default(now())
  requestKey String?  @unique

  chatter    User     @relation("ChatterPayments", fields: [chatterId], references: [id], onDelete: Restrict)
  manager    User     @relation("ManagerPayments", fields: [managerId], references: [id], onDelete: Restrict)
  earnings   Earnings[]

  @@index([chatterId, paidAt])
}

model ChatMessage {
  id               String   @id @default(cuid())
  modelTagId       String
  senderId         String
  content          String
  createdAt        DateTime @default(now())

  modelTag         ModelTag @relation(fields: [modelTagId], references: [id], onDelete: Restrict)
  sender           User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)

  @@index([modelTagId, createdAt])
}

model RefreshSession {
  id               String   @id @default(cuid())
  userId           String
  tokenHash        String   @unique
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  revokedAt        DateTime?
  replacedByTokenHash String?

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AuditLog {
  id               String      @id @default(cuid())
  actorId          String?
  action           AuditAction
  targetType       String
  targetId         String?
  metadata         Json?
  createdAt        DateTime    @default(now())

  actor            User?       @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([action, createdAt])
  @@index([targetType, targetId])
}

model Evidence {
  id             String         @id @default(cuid())
  uploadedById   String
  storageKey     String?        @unique
  originalName   String
  mimeType       String
  sizeBytes      Int
  sha256         String?
  status         EvidenceStatus @default(AVAILABLE)
  createdAt      DateTime       @default(now())
  attachedAt     DateTime?
  purgedAt       DateTime?

  uploadedBy     User           @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  startShift     Shift?         @relation("StartEvidence")
  endShift       Shift?         @relation("EndEvidence")
  deletionJob    StorageDeletionJob?

  @@index([uploadedById, createdAt])
  @@index([status, createdAt])
}

model StorageDeletionJob {
  id            String                @id @default(cuid())
  evidenceId    String                @unique
  storageKey    String
  status        StorageDeletionStatus @default(PENDING)
  attempts      Int                   @default(0)
  lastError     String?
  nextAttemptAt DateTime              @default(now())
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  evidence      Evidence              @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
}

model Notification {
  id               String           @id @default(cuid())
  userId           String
  type             NotificationType
  title            String
  message          String
  sourceType       String
  sourceId         String
  metadata         Json?
  readAt           DateTime?
  createdAt        DateTime         @default(now())

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, sourceId])
  @@index([userId, readAt, createdAt])
}
