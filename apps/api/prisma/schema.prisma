generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CHATTER
  MANAGER
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum EarningsStatus {
  PENDING
  PAID
}

enum ReconciliationStatus {
  MATCHED
  MISMATCH
  OUT_OF_RANGE
  AMBIGUOUS
  OVERRIDDEN
}

enum WorksheetCellType {
  TEXT
  NUMBER
}

enum AuditAction {
  LOGIN
  LOGIN_FAILED
  ACCOUNT_LOCKED
  LOGOUT
  PASSWORD_CHANGED
  USER_CREATED
  USER_UPDATED
  TAG_CREATED
  TAG_UPDATED
  TAG_DELETED
  CHATTER_MODEL_TAGS_UPDATED
  SHIFT_STARTED
  SHIFT_CLOSED
  SHIFT_UPDATED
  SHIFT_NOTES_UPDATED
  SHIFT_VERIFIED
  SHIFT_UNVERIFIED
  PAYMENT_MADE
  STATEMENT_IMPORTED
  RECONCILIATION_OVERRIDDEN
  PAYMENT_RECEIPT_UPLOADED
  SHIFT_DELETED
  EVIDENCE_UPLOADED
  EVIDENCE_PURGED
  PASSWORD_RESET
  SESSIONS_REVOKED
}

enum NotificationType {
  OCR_LOW_CONFIDENCE
  NEGATIVE_SHIFT
  SHIFT_OPEN_REMINDER
  MIDNIGHT_SHIFT_WARNING
}

enum EvidenceStatus {
  AVAILABLE
  PURGE_PENDING
  PURGED
  MISSING_LEGACY
}

enum StorageDeletionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id                  String            @id @default(cuid())
  username            String            @unique
  displayName         String
  passwordHash        String
  role                Role
  isActive            Boolean           @default(true)
  failedLoginAttempts Int               @default(0)
  lockedUntil         DateTime?
  authVersion         Int               @default(0)
  mustChangePassword  Boolean           @default(false)
  payoutPercentage    Int               @default(20)
  shiftReminderIntervalMinutes Int      @default(60)
  deletedAt           DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  chatterModelTags    ChatterModelTag[] @relation("ChatterTags")
  shifts              Shift[]           @relation("ChatterShifts")
  sentMessages        ChatMessage[]     @relation("MessageSender")
  refreshSessions     RefreshSession[]
  earnings            Earnings[]        @relation("ChatterEarnings")
  paymentHistory      PaymentHistory[]  @relation("ChatterPayments")
  paidPayments        PaymentHistory[]  @relation("ManagerPayments")
  auditEntries        AuditLog[]        @relation("AuditActor")
  notifications       Notification[]
  uploadedEvidence    Evidence[]
  statementImports    SalesStatementImport[] @relation("StatementImportManager")
  reconciliationOverrides ShiftReconciliation[] @relation("ReconciliationOverrideManager")
  worksheetCells      ModelWorksheetCell[] @relation("WorksheetCellEditor")
  paymentReceipts     PaymentReceipt[] @relation("PaymentReceiptUploader")

  @@index([role])
  @@index([role, deletedAt])
}

model ModelTag {
  id               String            @id @default(cuid())
  name             String            @unique
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  chatterLinks     ChatterModelTag[]
  shifts           Shift[]
  messages         ChatMessage[]
  worksheet        ModelWorksheet?
  statementImports SalesStatementImport[]
}

model ChatterModelTag {
  id               String   @id @default(cuid())
  chatterId        String
  modelTagId       String
  createdAt        DateTime @default(now())

  chatter          User     @relation("ChatterTags", fields: [chatterId], references: [id], onDelete: Cascade)
  modelTag         ModelTag @relation(fields: [modelTagId], references: [id], onDelete: Cascade)

  @@unique([chatterId, modelTagId])
  @@index([modelTagId])
}

model Shift {
  id                   String      @id @default(cuid())
  batchId              String?
  chatterId            String
  modelTagId           String
  status               ShiftStatus @default(OPEN)
  startedAt            DateTime
  endedAt              DateTime?

  startImageUrl        String?
  startEvidenceId      String?     @unique
  startOcrRawText      String?
  startOcrConfidence   Decimal?    @db.Decimal(5, 4)
  startValueCents      Int
  startOriginalCurrency String     @default("BRL")
  startOriginalAmountCents Int?
  startFxRate          Decimal?    @db.Decimal(18, 8)
  startFxProvider      String?
  startFxQuotedAt      DateTime?
  startValueConfirmedAt DateTime?

  endImageUrl          String?
  endEvidenceId        String?     @unique
  endOcrRawText        String?
  endOcrConfidence     Decimal?    @db.Decimal(5, 4)
  endValueCents        Int?
  endOriginalCurrency String?
  endOriginalAmountCents Int?
  endFxRate            Decimal?    @db.Decimal(18, 8)
  endFxProvider        String?
  endFxQuotedAt        DateTime?
  endValueConfirmedAt  DateTime?

  grossAmountCents     Int?
  commissionDivisor    Int?
  payoutPercentage     Int?
  payoutAmountCents    Int?
  negativeJustification String?
  notes                String?
  chatterVerifiedAt    DateTime?
  reviewRevision       Int         @default(1)

  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  chatter              User        @relation("ChatterShifts", fields: [chatterId], references: [id], onDelete: Restrict)
  modelTag             ModelTag    @relation(fields: [modelTagId], references: [id], onDelete: Restrict)
  earnings             Earnings?
  startEvidence        Evidence?   @relation("StartEvidence", fields: [startEvidenceId], references: [id], onDelete: SetNull)
  endEvidence          Evidence?   @relation("EndEvidence", fields: [endEvidenceId], references: [id], onDelete: SetNull)
  reconciliations      ShiftReconciliation[]

  @@index([chatterId, startedAt])
  @@index([modelTagId, status])
  @@index([batchId])
  @@index([modelTagId, startedAt, endedAt])
}

model Earnings {
  id          String         @id @default(cuid())
  chatterId   String
  shiftId     String         @unique
  amountCents Int
  status      EarningsStatus @default(PENDING)
  paidAt      DateTime?
  paymentId   String?
  createdAt   DateTime       @default(now())

  chatter     User           @relation("ChatterEarnings", fields: [chatterId], references: [id], onDelete: Restrict)
  shift       Shift          @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  payment     PaymentHistory? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([chatterId, status])
  @@index([status])
  @@index([paymentId])
}

model PaymentHistory {
  id         String   @id @default(cuid())
  chatterId  String
  managerId  String
  totalCents Int
  paidAt     DateTime @default(now())
  requestKey String?  @unique
  receiptId  String?  @unique

  chatter    User     @relation("ChatterPayments", fields: [chatterId], references: [id], onDelete: Restrict)
  manager    User     @relation("ManagerPayments", fields: [managerId], references: [id], onDelete: Restrict)
  earnings   Earnings[]
  receipt    PaymentReceipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  reconciliations ShiftReconciliation[]

  @@index([chatterId, paidAt])
}

model ChatMessage {
  id               String   @id @default(cuid())
  modelTagId       String
  senderId         String
  content          String
  kind             String   @default("USER")
  createdAt        DateTime @default(now())

  modelTag         ModelTag @relation(fields: [modelTagId], references: [id], onDelete: Restrict)
  sender           User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)

  @@index([modelTagId, createdAt])
}

model RefreshSession {
  id               String   @id @default(cuid())
  userId           String
  tokenHash        String   @unique
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  revokedAt        DateTime?
  replacedByTokenHash String?

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AuditLog {
  id               String      @id @default(cuid())
  actorId          String?
  action           AuditAction
  targetType       String
  targetId         String?
  metadata         Json?
  createdAt        DateTime    @default(now())

  actor            User?       @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([action, createdAt])
  @@index([targetType, targetId])
}

model PaymentReceipt {
  id           String   @id @default(cuid())
  uploadedById String
  storageKey   String   @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  sha256       String
  attachedAt   DateTime?
  createdAt    DateTime @default(now())

  uploadedBy   User     @relation("PaymentReceiptUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  payment      PaymentHistory?

  @@index([uploadedById, createdAt])
  @@index([attachedAt, createdAt])
}

model SalesStatementImport {
  id                    String   @id @default(cuid())
  managerId             String
  modelTagId            String
  originalName          String
  fileSha256            String
  vendorName            String
  coverageStart         DateTime
  coverageEnd           DateTime
  rowCount              Int
  confirmedRowCount     Int
  excludedRowCount      Int
  totalSalesCents       Int
  totalCommissionCents  Int
  unmatchedRowCount     Int
  createdAt             DateTime @default(now())

  manager               User     @relation("StatementImportManager", fields: [managerId], references: [id], onDelete: Restrict)
  modelTag              ModelTag @relation(fields: [modelTagId], references: [id], onDelete: Restrict)
  reconciliations       ShiftReconciliation[]

  @@index([modelTagId, createdAt])
  @@index([managerId, createdAt])
}

model ShiftReconciliation {
  id                       String               @id @default(cuid())
  importId                 String
  shiftId                  String
  shiftReviewRevision      Int
  statementCommissionCents Int
  reportedGrossCents       Int
  deltaCents               Int
  matchedRowCount          Int
  status                   ReconciliationStatus
  overriddenById           String?
  overrideReason           String?
  overriddenAt             DateTime?
  paymentId                String?
  createdAt                DateTime             @default(now())

  statementImport          SalesStatementImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  shift                    Shift                @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  overriddenBy             User?                @relation("ReconciliationOverrideManager", fields: [overriddenById], references: [id], onDelete: Restrict)
  payment                  PaymentHistory?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([importId, shiftId])
  @@index([shiftId, shiftReviewRevision, createdAt])
  @@index([paymentId])
}

model ModelWorksheet {
  id          String   @id @default(cuid())
  modelTagId  String   @unique
  rowCount    Int      @default(20)
  columnCount Int      @default(6)
  revision    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modelTag    ModelTag @relation(fields: [modelTagId], references: [id], onDelete: Cascade)
  cells       ModelWorksheetCell[]
}

model ModelWorksheetCell {
  id          String            @id @default(cuid())
  worksheetId String
  rowIndex    Int
  columnIndex Int
  value       String
  valueType   WorksheetCellType @default(TEXT)
  version     Int               @default(1)
  updatedById String
  updatedAt   DateTime          @updatedAt

  worksheet   ModelWorksheet    @relation(fields: [worksheetId], references: [id], onDelete: Cascade)
  updatedBy   User              @relation("WorksheetCellEditor", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([worksheetId, rowIndex, columnIndex])
  @@index([worksheetId, updatedAt])
}

model Evidence {
  id             String         @id @default(cuid())
  uploadedById   String
  storageKey     String?        @unique
  originalName   String
  mimeType       String
  sizeBytes      Int
  sha256         String?
  status         EvidenceStatus @default(AVAILABLE)
  createdAt      DateTime       @default(now())
  attachedAt     DateTime?
  purgedAt       DateTime?

  uploadedBy     User           @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  startShift     Shift?         @relation("StartEvidence")
  endShift       Shift?         @relation("EndEvidence")
  deletionJob    StorageDeletionJob?

  @@index([uploadedById, createdAt])
  @@index([status, createdAt])
}

model StorageDeletionJob {
  id            String                @id @default(cuid())
  evidenceId    String                @unique
  storageKey    String
  status        StorageDeletionStatus @default(PENDING)
  attempts      Int                   @default(0)
  lastError     String?
  nextAttemptAt DateTime              @default(now())
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  evidence      Evidence              @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
}

model Notification {
  id               String           @id @default(cuid())
  userId           String
  type             NotificationType
  title            String
  message          String
  sourceType       String
  sourceId         String
  metadata         Json?
  isTransient      Boolean          @default(false)
  readAt           DateTime?
  createdAt        DateTime         @default(now())

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, sourceId])
  @@index([userId, readAt, createdAt])
}
